# Security headers for every page (Mozilla Observatory, 15 Nov 2026).
# CSP lists every outside service the pages use. If you add one (a new embed,
# analytics, a map provider), add its address here or the browser will block it.
# 'unsafe-inline' for scripts is needed by Next.js's static pages.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https://tile.openstreetmap.org; font-src 'self' data:; connect-src 'self' https://api.web3forms.com https://api.postcodes.io https://cloudflareinsights.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/__forms.html
  X-Robots-Tag: noindex

/custom-price*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache

/weather-check*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache

/api/*
  X-Robots-Tag: noindex, nofollow

/map*
  X-Robots-Tag: noindex, nofollow, noarchive

/report/*
  X-Robots-Tag: noindex, nofollow, noarchive

/review*
  X-Robots-Tag: noindex, nofollow

/drafts*
  X-Robots-Tag: noindex, nofollow, noarchive

/enquiry*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Cache-Control: no-store

/account*
  X-Robots-Tag: noindex, nofollow

/admin*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
